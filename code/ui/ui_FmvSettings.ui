 </customwidgets>
 <resources>
  <include location="resources.qrc"/>
 </resources>
 <connections>
  <connection>
   <sender>btn_ffmpegBrowse</sender>
   <signal>clicked()</signal>
   <receiver>FmvSettings</receiver>
   <slot>pickFfmpegFolder()</slot>
  </connection>
  <connection>
   <sender>btn_dtmBrowse</sender>
   <signal>clicked()</signal>
   <receiver>FmvSettings</receiver>
   <slot>pickDtmFile()</slot>
  </connection>
  <connection>
   <sender>btn_checkDeps</sender>
   <signal>clicked()</signal>
   <receiver>FmvSettings</receiver>
   <slot>refreshStatus()</slot>
  </connection>
  <connection>
   <sender>btn_installDeps</sender>
   <signal>clicked()</signal>
   <receiver>FmvSettings</receiver>
   <slot>runInstaller()</slot>
  </connection>
  <connection>
   <sender>btn_restoreLayerStyles</sender>
   <signal>clicked()</signal>
   <receiver>FmvSettings</receiver>
   <slot>restoreDefaultLayerStyles()</slot>
  </connection>
  <connection>
   <sender>btn_onnxBrowse</sender>
   <signal>clicked()</signal>
   <receiver>FmvSettings</receiver>
   <slot>pickOnnxModel()</slot>
  </connection>
  <connection>
   <sender>btn_downloadVisdrone</sender>
   <signal>clicked()</signal>
   <receiver>FmvSettings</receiver>
   <slot>downloadVisdroneModel()</slot>
  </connection>
  <connection>
   <sender>btn_downloadYolo</sender>
   <signal>clicked()</signal>
   <receiver>FmvSettings</receiver>
   <slot>downloadYoloModel()</slot>
  </connection>
  <connection>
   <sender>sl_Size</sender>
   <signal>sliderMoved(int)</signal>
   <receiver>FmvSettings</receiver>
   <slot>showSizeTip(int)</slot>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>FmvSettings</receiver>
   <slot>saveSettings()</slot>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>FmvSettings</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>
 <slots>
  <slot>showSizeTip(int)</slot>
  <slot>pickFfmpegFolder()</slot>
  <slot>pickDtmFile()</slot>
  <slot>refreshStatus()</slot>
  <slot>runInstaller()</slot>
  <slot>saveSettings()</slot>
  <slot>restoreDefaultLayerStyles()</slot>
  <slot>pickOnnxModel()</slot>
  <slot>downloadVisdroneModel()</slot>
  <slot>downloadYoloModel()</slot>
 </slots>
</ui>
